<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Never cloud-backup user ROMs, staged caches, or raw private save files automatically;
         battery saves are explicitly exported/imported by the user via SAF (ADR-0004). -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
